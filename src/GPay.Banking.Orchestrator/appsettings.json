{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [ "http://localhost:4200", "http://localhost" ]
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest",
    "ClogThreshold": 1000,
    "ManagementBaseUrl": "http://localhost:15672"
  },
  "Elasticsearch": {
    "Enabled": false,
    "Uri": "http://localhost:9200",
    "IndexFormat": "gpay-banking-{0:yyyy.MM.dd}"
  },
  "ConnectionStrings": {
    "Banking": "SET_IN_appsettings.Local.json"
  },
  "Database": {
    "ConnectionStringName": "Banking",
    "UseInMemory": false,
    "EnsureCreated": false
  },
  "Banking": {
    "Banks": [
      {
        "BankCode": "Absa",
        "Name": "Absa",
        "RequestQueue": "gpay.banking.absa.requests",
        "HealthUrl": "http://localhost:5101/health"
      }
    ]
  }
}
