{
  "App": {
    "CorsOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=GPayDev;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "AuthServer": {
    "Authority": "https://localhost:44309",
    "RequireHttpsMetadata": false,
    "Audience": "GPay",
    "RequireGpayAuth": false
  },
  "BankStatusPoll": {
    "Enabled": true,
    "PeriodSeconds": 60,
    "BatchSize": 25
  },
  "BankHub": {
    "PollPeriodSeconds": 120,
    "BatchSize": 25
  },
  "GpayNotifications": {
    "SmtpHost": "relay.sautech.co.za",
    "SmtpPort": 2525,
    "EnableSsl": false,
    "From": "bank-hub@gpay.co.za",
    "Username": "",
    "Password": "",
    "SendTimeoutSeconds": 30,
    "PaymentInitiatedRecipients": "admin@gpay.co.za, dev@gpay.co.za"
  },
  "BankCallbacks": {
    "EnforceSourceAllowList": false
  },
  "AvsBatch": {
    "MaxItems": 20000,
    "DegreeOfParallelism": 5
  },
  "StringEncryption": {
    "DefaultPassPhrase": "GPayBanking_ChangeMe"
  }
}
